{
  "name": "pris718server",
  "displayName": "pris718server",
  "description": "pris GPU search server",
  "author": "lxy",
  "publisher": "pris718server",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pris.pris718",
        "title": "pris718"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pris718_activitybar",
          "title": "pris-718",
          "icon": "resources/resized_icon.svg"
        }
      ]
    },
    "views": {
      "pris718_activitybar": [
        {
          "type": "webview",
          "id": "pris718_activitybar.sidebarView",
          "name": "pris-718服务器"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
